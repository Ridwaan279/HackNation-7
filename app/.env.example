# Copy to app/.env. Keys stay in the main process; renderers never see them.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ElevenLabs agent IDs (setup: src/renderer/agents/README.md).
# Read by the main process, which mints a conversation token when ELEVENLABS_API_KEY is set.
VITE_AGENT_INTERVIEWER=
VITE_AGENT_DEBRIEF=
VITE_AGENT_TUTOR=
# Dedicated voice help agent. If empty, Ask Protégé reuses VITE_AGENT_TUTOR with a prompt override.
VITE_AGENT_ASSISTANT=

# OpenAI model names (never hard-coded in code). Both must accept images and JSON mode.
# MODEL_FAST: a quick, cheap model (step descriptions, question picker, guardrail checks, profiles).
# MODEL_SMART: a stronger model (Work Map, debrief gaps, Polish, mastery report).
MODEL_FAST=
MODEL_SMART=

# Replay a fixture instead of spawning the Python sidecar, e.g. ../fixtures/expert-session.jsonl
OBSERVER_FAKE=

# Optional (Agent B)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8NyzM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# APPRENTICE_ROLE=Accounts payable clerk
# APPRENTICE_EXPERT=Sabine
# GATE_MIN_GAP_S=45
# Seconds the expert gets to introduce the task (talking or working) before the first question.
# GATE_WARMUP_S=10
# GHOST_CONTENT_PROTECTION=1   # hides the ghost from ALL screen capture (incl. OBS/Zoom)
# OVERLAY_DEVTOOLS=1
